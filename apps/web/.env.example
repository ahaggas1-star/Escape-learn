# Supabase — انسخ هذا الملف إلى .env.local واملأ القيم من مشروعك
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# السكيمة في قاعدة البيانات:
#   - public  : لمشروع Supabase مخصّص (الافتراضي)
#   - ghars   : عند مشاركة مشروع قائم (عزل غرس في سكيمة مستقلة)
NEXT_PUBLIC_SUPABASE_DB_SCHEMA=ghars
